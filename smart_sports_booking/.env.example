# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ===== RAZORPAY PAYMENT GATEWAY =====
# Get these from: https://dashboard.razorpay.com/#/app/settings/api-keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=test_secret_key_xxxxxxxxxxxxx

# ===== EXTERNAL APIs FOR GROUNDS/TURFS =====
# For JustDial API (if using)
JUSTDIAL_API_KEY=your_justdial_api_key

# For Google Places API (if using)
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# For Custom Sports API
SPORTS_API_KEY=your_custom_sports_api_key

# ===== FLASK CONFIGURATION =====
# Change to a random secret key in production
SECRET_KEY=your-super-secret-key-change-this-in-production

# Database URL (optional, defaults to SQLite)
# DATABASE_URL=postgresql://user:password@localhost/turfzone

# ===== EMAIL CONFIGURATION (Optional) =====
# For sending booking confirmation emails
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@turfzone.com

# ===== ENVIRONMENT =====
# Set to 'production' for production deployment
FLASK_ENV=development
DEBUG=True

# Notes:
# 1. For Razorpay test mode: Use rzp_test_* keys
# 2. For Razorpay live mode: Use rzp_live_* keys and production secret
# 3. Never commit this file to version control
# 4. Add .env to .gitignore
